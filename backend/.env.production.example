# ===================================================
# HAUBITZ BACKEND - VARIÁVEIS DE AMBIENTE PRODUÇÃO
# Use este arquivo no Portainer (Stack Environment Variables)
# ===================================================

# Banco MariaDB (será criado pelo próprio container)
DB_ROOT_PASSWORD=SuaSenhaRoot@2024!
DB_PASSWORD=SuaSenhaUser@2024!

# JWT - Gere valores únicos para produção!
# Sugestão: openssl rand -base64 64
JWT_SECRET=TROQUE-ISSO-POR-UMA-CHAVE-SECRETA-LONGA-E-UNICA
JWT_REFRESH_SECRET=TROQUE-ISSO-POR-OUTRA-CHAVE-SECRETA-DIFERENTE

# Servidor
PORT=3000

# Conta do SuperAdmin (Kayke)
ADMIN_EMAIL=kayke@haubitz.com.br
ADMIN_PASSWORD=Haubitz@2024!
ADMIN_NAME=Kayke
