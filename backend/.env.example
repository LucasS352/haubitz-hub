DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/haubitz"

JWT_SECRET="sua-chave-secreta-jwt"
JWT_REFRESH_SECRET="sua-chave-secreta-refresh"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development
BCRYPT_ROUNDS=12

